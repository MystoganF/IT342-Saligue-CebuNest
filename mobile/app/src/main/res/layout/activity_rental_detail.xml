<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/white">
        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:title="Rental Details"
            app:titleTextColor="@color/teal_deep"
            app:navigationIcon="@android:drawable/ic_menu_revert" />
    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Property Image -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="220dp"
                android:background="#D4EAEB">
                <ImageView
                    android:id="@+id/ivPropertyImage"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"/>
                <TextView
                    android:id="@+id/tvNoImage"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:text="🏠 No Image"
                    android:textColor="@color/teal_soft"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:visibility="gone"/>
            </FrameLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <!-- Title & Status -->
                <TextView android:id="@+id/tvPropertyTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/teal_deep" android:textSize="22sp" android:textStyle="bold" />
                <TextView android:id="@+id/tvLocation" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/slate" android:textSize="14sp" android:layout_marginBottom="16dp" />

                <!-- SUMMARY CARD -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="2dp"
                    app:cardBackgroundColor="@color/white"
                    app:strokeWidth="2dp"
                    app:strokeColor="#D4AB6A"
                    android:layout_marginBottom="20dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp">
                        <TextView android:id="@+id/tvPrice" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/teal_deep" android:textSize="26sp" android:textStyle="bold" android:layout_marginBottom="12dp"/>
                        <TextView android:id="@+id/tvSummaryDetails" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/slate" android:textSize="13sp" android:lineSpacingExtra="6dp"/>

                        <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#F0F4F5" android:layout_marginVertical="16dp"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="PAYMENT PROGRESS" android:textSize="11sp" android:textStyle="bold" android:textColor="@color/teal_deep" android:layout_marginBottom="8dp"/>
                        <ProgressBar android:id="@+id/pbPaymentProgress" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="8dp" android:progressDrawable="@drawable/bg_dark_overlay" android:progressTint="@color/teal_deep" android:max="100" android:layout_marginBottom="8dp"/>
                        <TextView android:id="@+id/tvProgressText" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="12sp" android:textColor="@color/slate"/>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- DYNAMIC ACCORDIONS CONTAINER -->
                <LinearLayout
                    android:id="@+id/layoutActionAccordions"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone"
                    android:layout_marginBottom="24dp">

                    <!-- 1. Payment Schedule (Yearly) -->
                    <com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content" app:cardCornerRadius="12dp" app:cardElevation="1dp" app:strokeColor="#E2E8F0" app:strokeWidth="1dp" android:layout_marginBottom="16dp">
                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
                            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Payment Schedule" android:textStyle="bold" android:textColor="@color/teal_deep" android:background="#F8FAFC" android:padding="16dp"/>
                            <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#E2E8F0"/>
                            <LinearLayout android:id="@+id/containerPaymentSchedule" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="8dp"/>
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <!-- 2. Payment History -->
                    <com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content" app:cardCornerRadius="12dp" app:cardElevation="1dp" app:strokeColor="#E2E8F0" app:strokeWidth="1dp" android:layout_marginBottom="16dp">
                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
                            <LinearLayout android:id="@+id/btnToggleHistory" android:layout_width="match_parent" android:layout_height="wrap_content" android:background="?attr/selectableItemBackground" android:padding="16dp" android:gravity="center_vertical" android:clickable="true" android:focusable="true">
                                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Payment History" android:textStyle="bold" android:textColor="@color/teal_deep"/>
                                <TextView android:id="@+id/tvHistoryChevron" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="▼" android:textColor="@color/teal_deep"/>
                            </LinearLayout>
                            <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#E2E8F0"/>
                            <LinearLayout android:id="@+id/containerPaymentHistory" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp" android:visibility="gone"/>
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <!-- 3. Extensions -->
                    <com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content" app:cardCornerRadius="12dp" app:cardElevation="1dp" app:strokeColor="#E2E8F0" app:strokeWidth="1dp">
                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
                            <LinearLayout android:id="@+id/btnToggleExtensions" android:layout_width="match_parent" android:layout_height="wrap_content" android:background="?attr/selectableItemBackground" android:padding="16dp" android:gravity="center_vertical" android:clickable="true" android:focusable="true">
                                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Lease Extension Requests" android:textStyle="bold" android:textColor="@color/teal_deep"/>
                                <TextView android:id="@+id/tvExtensionsChevron" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="▼" android:textColor="@color/teal_deep"/>
                            </LinearLayout>
                            <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#E2E8F0"/>
                            <LinearLayout android:id="@+id/containerExtensionsBody" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp" android:visibility="gone">
                                <LinearLayout android:id="@+id/containerExtensionsList" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginBottom="8dp"/>
                                <Button android:id="@+id/btnRequestExtension" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="+ Request Extension" android:textColor="@color/teal_deep" android:backgroundTint="#F0F4F5" app:strokeColor="@color/teal_aero" app:strokeWidth="1dp" style="?attr/materialButtonOutlinedStyle"/>
                                <LinearLayout android:id="@+id/layoutExtensionForm" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone">
                                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Months" android:textSize="11sp" android:textStyle="bold" android:textColor="@color/teal_deep"/>
                                    <EditText android:id="@+id/etExtMonths" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="number" android:text="1" android:background="@drawable/bg_dark_overlay" android:backgroundTint="#F8FBFB" android:padding="12dp" android:layout_marginVertical="8dp"/>
                                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Reason" android:textSize="11sp" android:textStyle="bold" android:textColor="@color/teal_deep"/>
                                    <EditText android:id="@+id/etExtReason" android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@drawable/bg_dark_overlay" android:backgroundTint="#F8FBFB" android:padding="12dp" android:layout_marginVertical="8dp"/>
                                    <Button android:id="@+id/btnSubmitExtension" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Submit Request" android:backgroundTint="@color/teal_deep"/>
                                </LinearLayout>
                            </LinearLayout>
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>
                </LinearLayout>

                <!-- TENANT REVIEWS -->
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="TENANT REVIEWS" android:textSize="13sp" android:textStyle="bold" android:textColor="@color/teal_deep" android:layout_marginBottom="12dp"/>
                <com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content" app:cardCornerRadius="16dp" app:cardBackgroundColor="@color/white" app:cardElevation="2dp" android:layout_marginBottom="24dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp">
                        <!-- Public Reviews -->
                        <TextView android:id="@+id/tvReviewsSummary" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Loading reviews..." android:textColor="@color/slate" android:textSize="14sp" android:layout_marginBottom="12dp"/>
                        <LinearLayout android:id="@+id/containerPublicReviews" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginBottom="16dp"/>

                        <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#F0F4F5" android:layout_marginBottom="16dp"/>

                        <!-- Rate This Property (User Form) -->
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="⭐ RATE THIS PROPERTY" android:textStyle="bold" android:textColor="@color/teal_deep" android:textSize="13sp" android:layout_marginBottom="12dp"/>
                        <LinearLayout android:id="@+id/layoutReviewForm" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
                            <LinearLayout android:id="@+id/layoutStarPicker" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center" android:layout_marginBottom="12dp">
                                <ImageView android:id="@+id/star1" android:layout_width="36dp" android:layout_height="36dp" android:src="@android:drawable/btn_star_big_off" app:tint="#DDDDDD"/>
                                <ImageView android:id="@+id/star2" android:layout_width="36dp" android:layout_height="36dp" android:src="@android:drawable/btn_star_big_off" app:tint="#DDDDDD"/>
                                <ImageView android:id="@+id/star3" android:layout_width="36dp" android:layout_height="36dp" android:src="@android:drawable/btn_star_big_off" app:tint="#DDDDDD"/>
                                <ImageView android:id="@+id/star4" android:layout_width="36dp" android:layout_height="36dp" android:src="@android:drawable/btn_star_big_off" app:tint="#DDDDDD"/>
                                <ImageView android:id="@+id/star5" android:layout_width="36dp" android:layout_height="36dp" android:src="@android:drawable/btn_star_big_off" app:tint="#DDDDDD"/>
                            </LinearLayout>
                            <EditText android:id="@+id/etReviewComment" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Share your experience..." android:background="@drawable/bg_dark_overlay" android:backgroundTint="#F8FBFB" android:padding="12dp" android:lines="2" android:gravity="top" android:layout_marginBottom="12dp"/>
                            <Button android:id="@+id/btnSubmitReview" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Submit Review" android:backgroundTint="@color/teal_deep"/>
                        </LinearLayout>
                        <!-- Submitted State -->
                        <LinearLayout android:id="@+id/layoutReviewSubmitted" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone" android:background="#0D1A7A4A" android:padding="16dp">
                            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="✓ Review Submitted" android:textColor="#1A7A4A" android:textStyle="bold" android:layout_marginBottom="4dp"/>
                            <TextView android:id="@+id/tvMyReviewStars" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#B78E42" android:textSize="18sp" android:layout_marginBottom="4dp"/>
                            <TextView android:id="@+id/tvMyReviewComment" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/slate" android:textStyle="italic"/>
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- MAP SECTION -->
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="🗺️ LOCATION" android:textSize="13sp" android:textStyle="bold" android:textColor="@color/teal_deep" android:layout_marginBottom="12dp"/>
                <com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="220dp" app:cardCornerRadius="16dp" app:cardElevation="2dp">
                    <TextView android:id="@+id/tvMapLoading" android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:text="📍 Finding location..." android:background="#F0F4F5"/>
                    <!-- Added settings for map to work reliably -->
                    <WebView android:id="@+id/webViewMap" android:layout_width="match_parent" android:layout_height="match_parent" android:visibility="gone"/>
                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.coordinatorlayout.widget.CoordinatorLayout>